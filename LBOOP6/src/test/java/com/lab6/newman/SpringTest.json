		{
			"name": "Create User",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"// Генерируем случайный суффикс для уникальности\r",
							"const random = Math.floor(Math.random() * 10000);\r",
							"\r",
							"// Устанавливаем переменные окружения для подстановки в тело запроса\r",
							"pm.environment.set(\"username\", `user${random}`);\r",
							"pm.environment.set(\"passwordHash\", \"hashedPassword!@#2025\");\r",
							"pm.environment.set(\"email\", `user${random}@example.com`);\r",
							"pm.environment.set(\"role\", \"USER\");"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Статус ответа 201 Created\", function () {\r",
							"    pm.response.to.have.status(201);\r",
							"});\r",
							"\r",
							"pm.test(\"Ответ содержит поле id\", function () {\r",
							"    const jsonData = pm.response.json();\r",
							"    pm.expect(jsonData).to.have.property(\"id\");\r",
							"    pm.environment.set(\"createdUserId\", jsonData.id);\r",
							"    pm.environment.set(\"createdUsername\", jsonData.username);\r",
							"});\r",
							"\r",
							"pm.test(\"Проверка структуры ответа\", function () {\r",
							"    const jsonData = pm.response.json();\r",
							"    pm.expect(jsonData).to.have.all.keys(\"id\", \"username\", \"email\", \"role\");\r",
							"});\r",
							"\r",
							"pm.test(\"Role корректна\", function () {\r",
							"    const jsonData = pm.response.json();\r",
							"    pm.expect([\"USER\", \"ADMIN\"]).to.include(jsonData.role);\r",
							"});\r",
							"\r",
							"if (pm.response.code !== 201) {\r",
							"    console.warn(`Пользователь не создан. Код ответа: ${pm.response.code}`);\r",
							"}"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\r\n  \"username\": \"{{username}}\",\r\n  \"passwordHash\": \"{{passwordHash}}\",\r\n  \"email\": \"{{email}}\",\r\n  \"role\": \"{{role}}\"\r\n}",
					"options": {
						"raw": {
