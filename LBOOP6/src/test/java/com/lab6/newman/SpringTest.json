		{
			"name": "Create Point",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"// Генерируем случайные координаты для точки\r",
							"const x = (Math.random() * 100).toFixed(2);\r",
							"const y = (Math.random() * 100).toFixed(2);\r",
							"\r",
							"pm.environment.set(\"pointX\", parseFloat(x));\r",
							"pm.environment.set(\"pointY\", parseFloat(y));\r",
							"\r",
							"// Убедимся, что functionId есть в окружении\r",
							"if (!pm.environment.get(\"functionId\")) {\r",
							"    throw new Error(\"functionId должен быть задан в переменных окружения\");\r",
							"}"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Статус 201 Created\", function () {\r",
							"    pm.response.to.have.status(201);\r",
							"});\r",
							"\r",
							"pm.test(\"Ответ содержит id\", () => {\r",
							"    const jsonData = pm.response.json();\r",
							"    pm.expect(jsonData.id).to.be.a(\"number\").and.to.be.above(0);\r",
							"    // Сохраняем id новой точки для последующих тестов\r",
							"    pm.environment.set(\"pointId\", jsonData.id);\r",
							"});\r",
							"\r",
							"pm.test(\"Проверка координат в ответе\", () => {\r",
							"    const jsonData = pm.response.json();\r",
							"    pm.expect(jsonData.x).to.eql(pm.environment.get(\"pointX\"));\r",
							"    pm.expect(jsonData.y).to.eql(pm.environment.get(\"pointY\"));\r",
							"});\r",
							"\r",
							"pm.test(\"Проверка связанной функции\", () => {\r",
							"    const jsonData = pm.response.json();\r",
							"    pm.expect(jsonData.functionId).to.eql(pm.environment.get(\"functionId\"));\r",
							"});"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\r\n    \"x\": {{pointX}},\r\n    \"y\": {{pointY}},\r\n    \"functionId\": {{functionId}}\r\n}",
