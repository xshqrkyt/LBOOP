		{
			"name": "Create Function",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"let fnName = \"Func_\" + Math.floor(Math.random() * 10000);\r",
							"let types = [\"SQR\", \"DEBOOR\", \"IDENTITY\"];\r",
							"let fnType = types[Math.floor(Math.random() * types.length)];\r",
							"\r",
							"pm.environment.set(\"functionName\", fnName);\r",
							"pm.environment.set(\"functionType\", fnType);"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Статус 201 Created\", function () {\r",
							"    pm.response.to.have.status(201);\r",
							"});\r",
							"\r",
							"const res = pm.response.json();\r",
							"\r",
							"// Проверка, что id существует и число\r",
							"pm.test(\"Response has valid id\", () => {\r",
							"    pm.expect(res.id).to.be.a('number').and.to.be.above(0);\r",
							"});\r",
							"\r",
							"// Сохраняем id и имя созданной функции\r",
							"pm.environment.set(\"functionId\", res.id);\r",
							"pm.environment.set(\"functionName\", res.name);"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "{\r\n  \"name\": \"{{functionName}}\",\r\n  \"type\": \"{{functionType}}\",\r\n  \"ownerId\": {{createdUserId}}\r\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "http://localhost:8080/spring/functions",
